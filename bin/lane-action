#!/usr/bin/env bash
# Action `lane.menu`: runs on the herdr server with no TTY, so it only resolves
# the invoking workspace's repo and hands it to the popup.
set -uo pipefail

herdr=$HERDR_BIN_PATH

fail() {
  "$herdr" notification show lane --body "$1" >/dev/null
  exit 1
}

command -v jq >/dev/null || fail "jq is not on PATH"
command -v lane >/dev/null || fail "lane is not on PATH"

# herdr fills `.worktree` only for workspaces it opened as worktrees, so git
# resolves the repo from the workspace's directory instead.
cwd=$(jq -r .workspace_cwd <<<"$HERDR_PLUGIN_CONTEXT_JSON")
checkout=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) ||
  fail "this workspace is not a git repository"
common=$(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir)
repo=$(dirname "$common")

"$herdr" plugin pane open --plugin lane --entrypoint menu --cwd "$repo" \
  --env "LANE_REPO_ROOT=$repo" --env "LANE_CHECKOUT=$checkout" --focus >/dev/null ||
  fail "could not open the lane menu"
